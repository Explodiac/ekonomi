# Örnek ortam değişkenleri. Kopyala: cp .env.example .env.local
# Gerçek değerleri .env.local'e yaz — .env.local git'e GİRMEZ (.gitignore).

# ── Supabase (tarayıcıya gider — NEXT_PUBLIC_ önekli) ──
# Supabase panel > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Yedekleme script'leri için (SUNUCU/LOKAL — Vercel'e GİTMEZ) ──
# Supabase panel > Project Settings > Database > Connection string > URI
# postgresql://postgres:<ŞİFRE>@<HOST>:5432/postgres
SUPABASE_DB_URL=

# ── Yalnız lokal geliştirme otomatik girişi (NODE_ENV=development) ──
# Production'da /api/dev-login 404 döner; bu değişkenler Vercel'e GİTMEZ.
SUPABASE_DEV_USER_EMAIL=
SUPABASE_DEV_USER_PASSWORD=
